# Auto-detect text files and normalize line endings to LF in the repository
* text=auto eol=lf

# Java / Spring Boot / Config source files
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.sh text eol=lf
/mvnw text eol=lf

# Windows scripts must keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files (do not alter)
*.jar binary
*.war binary
*.class binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
